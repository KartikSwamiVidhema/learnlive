import Link from "next/link";

const Breadcrumb = ({ categories = [], productName }) => {
    return (
        <nav
            aria-label="breadcrumb"
            className="breadcrumb-container flex gap-1 text-sm mb-4"
        >
            {/* Home Link */}
            <Link href="/" className="text-blue-600 hover:underline">
                Home
            </Link>

            {/* Loop categories */}
            {categories.map((cat, index) => (
                <span key={cat._id} className="flex items-center">
                    <span className="mx-1">{">"}</span>

                    {/* If last category, highlight */}
                    {index === categories.length - 1 ? (
                        <span className="bg-blue-600 text-white px-2 py-1 rounded">
                            {cat.name}
                        </span>
                    ) : (
                        <Link
                            href={`/product-category/${cat.slug}`}
                            className="text-blue-600 hover:underline"
                        >
                            {cat.name}
                        </Link>
                    )}
                </span>
            ))}
            console.log(categories);

            {/* Product Name */}
            <span className="flex items-center">
                <span className="mx-1">{">"}</span>
                <span
                    className="breadcrumb-current bg-blue-600 text-white px-2 py-1 rounded"
                    aria-current="page"
                >
                    {productName}
                </span>
            </span>
        </nav>
    );
};

export default Breadcrumb;
